# Firebase Web SDK (wymagane do logowania i synchronizacji portfela).
# Te wartości identyfikują projekt Firebase i trafiają do kodu przeglądarki.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# xAI (opcjonalne; wymagane tylko do analizy AI i transkrypcji głosu).
# XAI_API_KEY jest sekretem serwerowym. Nigdy nie dodawaj do niego prefiksu NEXT_PUBLIC_.
XAI_API_KEY=
XAI_MODEL=grok-4.3
